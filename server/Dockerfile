# صورة إنتاج للخادم السحابي (`lansher-server`).
#
# مرحلتان: بناء ثم تشغيل. البناء يُصرّف TypeScript فقط، ولا يتصل
# بأي قاعدة بيانات ولا يقرأ أي سرّ، فالصورة تُبنى بلا `DATABASE_URL`
# ولا تعمل. كل سرّ يأتي وقت التشغيل من Cloud Run.
#
# ترتيب الطبقات مقصود: الحزم في طبقة مستقلة عن نسخ المصدر، فإعادة
# البناء بعد تغيير في `src` لا تُعيد تنزيل الحزم.
#
# لا `HEALTHCHECK` هنا. Cloud Run يفحص الإقلاع بفحص خاص به على المنفذ
# المحقون، و`GET /healthz` استجابة HTTP في تطبيقنا، فلا فائدة من تعليم
# الحاوية فحصاً تتجاهله المنصّة.

# ------------------------------------------------------------------ البناء
FROM node:20-bookworm-slim AS build

WORKDIR /app

# **لا تضبط NODE_ENV في هذه المرحلة.** ضبطه يجعل `npm ci` يتخطّى
# اعتماديات التطوير، فيغيب `tsc` ويفشل البناء بلا سبب واضح.
COPY package.json package-lock.json ./
RUN npm ci

# `tsconfig.json` هو الأصل: `tsconfig.build.json` يمتدّ منه، فننسخهما
# معاً. لو نسخنا البناء وحده فشل التصريف على مفتاح مفقود.
COPY tsconfig.json tsconfig.build.json ./

# `npm run build` يبدأ بـ`tsc --noEmit` على `tsconfig.json` الذي يشمل
# `src` و`test` و`scripts`. لذلك ننسخ الثلاثة: صورة مبنية بنسخة ناقصة
# تفحص نوعاً أقل مما يفحصه جهاز المطوّر، فيمرّ البناء وهو أضعف مما
# يبدو. `db/` ليس للمصنّف، وسكربت الترحيل لا يدخل صورة التشغيل إطلاقاً.
COPY src ./src
COPY test ./test
COPY scripts ./scripts

# سكربت البناء يفحص الأنواع (`tsc --noEmit`) قبل الإخراج، فلا تُبنى
# صورة تحمل خطأ أنواع.
RUN npm run build

# ---------------------------------------------------------------- التشغيل
FROM node:20-bookworm-slim AS runtime

WORKDIR /app

# لا أسرار في الصورة. `NODE_ENV=production` هنا وحده يُبقي `npm ci`
# على اعتماديات التشغيل فقط.
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# `tsconfig.build.json` يُخرج `dist/` من `src/` وحدها، فلا يدخل صورة
# التشغيل إلا ما ينتجه البناء: لا اختبارات ولا سكربتات ولا ملف SQL.
COPY --from=build /app/dist ./dist

# مستخدم `node` موجود في الصورة الرسمية (المعرّف 1000). تشغيل الخادم
# بصلاحيات الجذر يوسّع الضرر لو ثُغرت خدمة أو ثُقّمت أدواتها.
USER node

# **المنفذ من المتغيّر لا من سطر هنا.** Cloud Run يحقن `PORT` في كل
# نسخة ويوجّه إليها حركة المرور وحدها، وقيمته الافتراضية عنده 8080.
# الخادم يقرأ `PORT` عبر `config().port`، و`EXPOSE` توثيق للبشر لا
# توجيه فعلي، فنكتب 8080 ليطابق الافتراضي لا ليحدّده.
EXPOSE 8080

# `dist/index.js` مخرج البناء. `node` مباشرةً بلا `tsx`: لا محمّل
# وحدات ولا مصدّر في الإنتاج.
CMD ["node", "dist/index.js"]

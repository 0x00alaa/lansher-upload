# نموذج بيئة الخادم السحابي (`lansher-server`).
#
# انسخه إلى `.env` واملأ كل قيمة:
#
#   Copy-Item .env.example .env
#
# **هذا الملف هو المكان الوحيد المسموح بذكر أسماء المتغيرات فيه.**
# لا تُنشأ نسخة منه في المستودع تحمل قيماً حقيقية: `.gitignore` يستثني
# `.env.example` صراحةً ويستثني كل `*.env` سواه، فلا تمرّ قيمة بالصدفة.
#
# **الخادم لا يقرأ `.env` بنفسه** (لا اعتماد `dotenv` في المشروع)،
# فإما تصدّر المتغيرات في الجلسة قبل التشغيل، أو تمرّر الملف إلى Node
# 20.6 فأحدث مباشرةً:
#
#   node --env-file=.env --import tsx scripts/migrate.ts
#
# الصيغة: `NAME=value` بلا علامات اقتباس، و`#` في أول السطر تعليق.
# ما بعد `=` يُقرأ حرفياً، فلا تحط مسافات حوله ولا حول الاسم.

# ===================================================================== إلزامي
# الأربعة التالية بلا قيم افتراضية. غاب أحدها يرفض الخادم الإقلاع
# برسالة تسمّيه. قيم الحشو أدناه تُظهر الشكل فقط ولا تصلح للإنتاج:
# الخادم يرفضها أو يقبل سرّاً يمكن التخمين عنه. قيمة ضعيفة تُشبه
# الصحيحة أسوأ من انقطاع صريح، لأن الانقطاع يقول لك والضعيفة تعمل.
#
# تنبيه خاص بالـpeppers: حشوهما أقصر من 32 محرفاً، فيرفضه الإنتاج، لكن
# **التطوير يقبله**. فبيئة تطوير بأساس سرّي معروف تُنتج بُرِداً مشفّرة
# بتجزئة يسهل ربطها، وتغيير القيمة لاحقاً يُبطل كل ما فيها. ولّد القيم
# الحقيقية قبل إنشاء أي حساب محلي.

# ---------------------------------------------------------------- DATABASE_URL
# رابط PostgreSQL، وكلمة المرور داخله. من أسرار الإنتاج: يبقى في Cloud
# SQL ولا يدخل صورة Docker ولا متغيّرات CI ولا سجلّات النشر.
# محلياً يكفي قاعدة واحدة ومستخدم واحد:
#   createdb lansher
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/lansher
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---------------------------------------------------------------- EMAIL_PEPPER
# مفتاح HMAC-SHA256 فوق تجزئة البريد (pepper). **سريّ ولا يُدوَّر**:
# تغييره يغيّر `email_hash` لكل بريد مسجَّل، فكل الحسابات القائمة تصير
# مجهولة. 32 محرفاً على الأقل في الإنتاج، و`config.ts` يرفض الأقصر.
# توليد قيمة جديدة (base64url، 43 محرفاً):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
EMAIL_PEPPER=CHANGE_ME_32_CHARS_MINIMUM

# -------------------------------------------------------------- SESSION_PEPPER
# سرّ يُضاف إلى توكن الجلسة قبل التجزئة، ويُوقَّع به توكن الوصول.
# تغييره يُبطل كل الجلسات والتوكنات القائمة فوراً، وهذا سلوك مقصود عند
# الاشتباه بتسريب. أسهل ما يُدوَّر لأنه لا يمسّ سجلّ المستخدمين.
# 32 محرفاً على الأقل في الإنتاج.
# توليد قيمة جديدة، **مختلفة** عن EMAIL_PEPPER لا مكرَّرة:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=CHANGE_ME_32_CHARS_MINIMUM

# -------------------------------------------------------- EMAIL_ENCRYPTION_KEY
# مفتاح AES-256-GCM لبريد المستخدم المشفَّر في الجدول. **base64 لـ32
# بايت بالضبط**: الفحص على عدد البايتات بعد فك الترميز، لا على عدد
# المحارف. تغييره يجعل كل البُرِد المخزَّنة غير قابلة للفك، أي أن
# الحسابات القائمة تفقد طريقتها الوحيدة في تسجيل الدخول.
# توليد (base64 قياسي، 44 محرفاً):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=CHANGE_ME_BASE64_OF_32_BYTES

# ================================================================== اختياري
# أدناه قيم افتراضية سليمة للتطوير. حذف السطر يُبقي الافتراضية، فما هنا
# توضيح لا التزام.

# بيئة التشغيل: development | production | test.
# **يجب أن تصير production في النشر**، فالفرق أمني لا تجميلي: في غير
# الإنتاج يعيد `POST /v1/auth/signup/start` رمز التأكيد في جسم الرد،
# وفي الإنتاج لا يعيده.
NODE_ENV=development

# منفذ الاستماع. Cloud Run يحقن PORT في كل نسخة (قيمته الافتراضية عنده
# 8080) ويحوّل حركة المرور إليه وحده، فلا تُثبّت منفذاً في صورة الإنتاج.
PORT=8080

# رابط الواجهة العامة، يُستعمل في تحويل رسائل البريد. افتراضياً
# `http://localhost:8080`، وفي الإنتاج نطاق حقيقي يبدأ بـ`https`.
PUBLIC_URL=http://localhost:8080

# عنوان مُرسِل البريد. **يُقرأ ولا يُستعمل بعد**: لا توجد خدمة إرسال في
# هذه النسخة، فلا تفترض أن تعبئته يوصّل شيئاً. حدِّده يوم تصل خدمة
# البريد، فحاجته إذ حينها.
MAIL_FROM=

# عمر جلسة الدخول (refresh token) بالأيام. تغييره لا يبطل الجلسات
# القائمة فوراً، لكنه يحدّد صلاحية التجديدات القادمة.
SESSION_TTL_DAYS=30

# عمر توكن الوصول بالثواني. قصير عمداً: التوكن موقَّع ومحمول في الذاكرة
# ويُتحقَّق منه بلا قراءة قاعدة، فإطالته توسّع نافذة إساءة الاستخدام بعد
# إبطال الجلسة.
ACCESS_TTL_SECONDS=900

# صلاحية رمز التأكيد بالبريد بالدقائق.
CODE_TTL_MINUTES=10

# عدد محاولات الدخول المتتالية الفاشلة قبل قفل الحساب، ومدة نافذة
# القفل بالدقائق. القفل على الحساب يوقف كسر PIN ولا يوقف إغراق الخادم،
# لذلك يبقى في `index.ts` حدّ معدّل مستقل على عنوان IP.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ذاكرة اشتقاق PIN بالكيلوبايت (65536 = 64 ميغابايت لكل محاولة تجزئة).
# اضبطها على عتاد نسخة Cloud Run لا على عتادك: الذاكرة كلفة تُدفع عند
# كل محاولة دخول، لا رقم مجاني.
ARGON2_MEMORY_KIB=65536

# عدد المسارات المتوازية في اشتقاق PIN. الواحد يكفي عادةً، وما فوقه
# يقلّل عدد الطلبات المتزامنة التي يخدمها النوى الواحد.
ARGON2_PARALLELISM=1

# معامل التكرارات. **تُقرأ ولا تُستعمل** في اشتقاق الـPIN الحالي
# (scrypt بمعاملَي الذاكرة والتوازي)، فتركها لا يغيّر شيئاً. مكتوبة
# صراحةً كي لا يفترض أحد أن رفعها يشدّ التشفير.
ARGON2_ITERATIONS=3

# ================================================== قبل النشر: قائمة مراجعة
# يجب تغييرها في الإنتاج، ولا تُترك كما في النموذج:
#   DATABASE_URL          رابط Cloud SQL، لا رابط محلي
#   EMAIL_PEPPER          قيمة جديدة من أمر التوليد
#   SESSION_PEPPER        قيمة جديدة مختلفة عن EMAIL_PEPPER
#   EMAIL_ENCRYPTION_KEY  base64 لـ32 بايت، يُحفظ في مدير أسرار
#   NODE_ENV=production   يوقف إرجاع رمز التأكيد في الرد
#   PUBLIC_URL            نطاق حقيقي يبدأ بـ`https` لروابط البريد
#   MAIL_FROM             يتطلّب خدمة بريد غير منفَّذة بعد
#
# يجب ألّا يُرفع أبداً إلى مستودع أو صورة أو سجلّ:
#   الملف `.env` بكل محتوياته، وصورة Docker مبنية بمتغيّرات محقونة،
#   وأيّ نسخة مؤقتة من أسرار داخل CI. الأسرار في مدير أسرار
#   (Secret Manager) أو في أسرار Cloud Run، لا في صورة.
#
# تذكير: تدوير EMAIL_PEPPER أو EMAIL_ENCRYPTION_KEY على قاعدة فيها
# مستخدمون حقيقيون يعني فقدان الوصول إليهم. أما SESSION_PEPPER وحده
# فتدويره آمن ويُبطل الجلسات فقط.
